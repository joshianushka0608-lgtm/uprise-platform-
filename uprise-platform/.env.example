# ============================================
# UpRise — Environment Variables Template
# ============================================
# Copy this to .env and fill in your values

# --- Backend ---
PORT=3001
DATABASE_URL=./data/uprise.db
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d

# Razorpay (get from razorpay.com)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# OpenAI (optional — for auto skill tagging)
OPENAI_API_KEY=your_openai_api_key

# OTP Service (optional — for SMS OTP)
OTP_SERVICE=fast2sms
OTP_API_KEY=your_otp_api_key

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000
